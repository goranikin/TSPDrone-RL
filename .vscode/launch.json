{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TSPD: Train",
      "type": "debugpy",
      "request": "launch",
      "module": "src.experiments.run",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "args": [
        "wandb.enabled=false",
        "action=train",
        "decoder=tspd_lstm",
        "dynamics=on",
        "physics.n_nodes=11",
        "scale=small",
        "trainer.batch_size=32",
        "trainer.epochs=100",
        "trainer.test_interval=50",
        "trainer.save_interval=50"
      ]
    },
    {
      "name": "TSPD: Eval (Greedy)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.experiments.run",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "args": [
        "wandb.enabled=false",
        "action=test",
        "decoder=tspd_lstm",
        "dynamics=on",
        "physics.n_nodes=11",
        "data.load_checkpoint=false"
      ]
    },
    {
      "name": "TSPD: Eval (Sampling)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.experiments.run",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "justMyCode": true,
      "args": [
        "wandb.enabled=false",
        "action=sampling",
        "decoder=tspd_lstm",
        "dynamics=on",
        "n_samples=5",
        "physics.n_nodes=11",
        "data.load_checkpoint=false"
      ]
    }
  ]
}
